{
  "name": "@nexora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexora TMS HTTP API",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "DATABASE_URL=\"${NEXORA_MIGRATOR_DATABASE_URL:-$DATABASE_URL}\" pnpm --filter @nexora/database db:migrate && node dist/main.js",
    "test": "pnpm build && node scripts/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "jose": "6.2.10",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
